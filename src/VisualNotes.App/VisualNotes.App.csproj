<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- VisualNotes depends on desktop APIs introduced in Windows 10 2004. -->
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <!-- The signed distribution currently supports native x64 only. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VisualNotes.Core\VisualNotes.Core.csproj" />
    <ProjectReference Include="..\VisualNotes.Infrastructure\VisualNotes.Infrastructure.csproj" />
  </ItemGroup>
</Project>
