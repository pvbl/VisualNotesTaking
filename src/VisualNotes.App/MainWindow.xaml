<Window x:Class="VisualNotes.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VisualNotes" Width="1100" Height="700" MinWidth="800" MinHeight="500"
        Background="#F4F6FA">
  <Window.Resources>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="14,12"/><Setter Property="Margin" Value="0,2"/><Setter Property="FontSize" Value="15"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#172033" Padding="18">
      <StackPanel>
        <TextBlock Text="VisualNotes" Foreground="White" FontSize="26" FontWeight="Bold" Margin="4,10,4,30"/>
        <Button Content="Sesión" Command="{Binding NavigateCommand}" CommandParameter="Session" Style="{StaticResource NavButton}"/>
        <Button Content="Capturas" Command="{Binding NavigateCommand}" CommandParameter="Captures" Style="{StaticResource NavButton}"/>
        <Button Content="Instrucciones" Command="{Binding NavigateCommand}" CommandParameter="Instructions" Style="{StaticResource NavButton}"/>
        <Button Content="Documento" Command="{Binding NavigateCommand}" CommandParameter="Document" Style="{StaticResource NavButton}"/>
        <Button Content="Configuración" Command="{Binding NavigateCommand}" CommandParameter="Settings" Style="{StaticResource NavButton}"/>
      </StackPanel>
    </Border>
    <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}" Margin="36"/>
  </Grid>
</Window>
