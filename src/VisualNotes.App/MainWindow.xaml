<Window x:Class="VisualNotes.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VisualNotes" AutomationProperties.AutomationId="MainWindow" AutomationProperties.Name="Ventana principal de VisualNotes"
        AutomationProperties.HelpText="Crea sesiones, revisa capturas y exporta tus notas" Width="1100" Height="700" MinWidth="800" MinHeight="500"
        Background="#F4F6FA">
  <Window.InputBindings>
    <KeyBinding Key="C" Modifiers="Control+Shift" Command="{Binding CaptureRegionCommand}"/>
    <KeyBinding Key="R" Modifiers="Control+Shift" Command="{Binding RedefineRegionCommand}"/>
  </Window.InputBindings>
  <Window.Resources>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="14,12"/><Setter Property="Margin" Value="0,2"/><Setter Property="FontSize" Value="15"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#172033" Padding="18">
      <DockPanel>
       <Border DockPanel.Dock="Bottom" Background="#243149" CornerRadius="8" Padding="12" Margin="0,16,0,0">
        <StackPanel><TextBlock Text="SESIÓN ACTIVA" Foreground="#94A3B8" FontSize="10" FontWeight="Bold"/>
         <TextBlock Text="{Binding ActiveSessionName}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
         <TextBlock Text="{Binding ActiveSectionName, StringFormat=§ {0}}" Foreground="#7DD3FC" TextTrimming="CharacterEllipsis" Margin="0,3,0,8"/>
         <Button AutomationProperties.AutomationId="SessionStatusButton" AutomationProperties.Name="Pausar o reanudar sesión" AutomationProperties.HelpText="Estado actual de la sesión; pulsa para alternarlo" Content="{Binding SessionStatus}" Command="{Binding TogglePauseCommand}" Padding="6"/>
        </StackPanel>
       </Border>
      <StackPanel>
        <TextBlock Text="VisualNotes" Foreground="White" FontSize="26" FontWeight="Bold" Margin="4,10,4,30"/>
        <Button AutomationProperties.AutomationId="NavSession" Content="Sesión" Command="{Binding NavigateCommand}" CommandParameter="Session" Style="{StaticResource NavButton}"/>
        <Button AutomationProperties.AutomationId="NavCaptures" Content="Capturas" Command="{Binding NavigateCommand}" CommandParameter="Captures" Style="{StaticResource NavButton}"/>
        <Button AutomationProperties.AutomationId="NavInstructions" Content="Instrucciones" Command="{Binding NavigateCommand}" CommandParameter="Instructions" Style="{StaticResource NavButton}"/>
        <Button AutomationProperties.AutomationId="NavDocument" Content="Documento" Command="{Binding NavigateCommand}" CommandParameter="Document" Style="{StaticResource NavButton}"/>
        <Button AutomationProperties.AutomationId="NavSettings" Content="Configuración" Command="{Binding NavigateCommand}" CommandParameter="Settings" Style="{StaticResource NavButton}"/>
      </StackPanel></DockPanel>
    </Border>
    <ContentControl AutomationProperties.AutomationId="PageContent" AutomationProperties.Name="Contenido de la página actual" Grid.Column="1" Content="{Binding CurrentViewModel}" Margin="36"/>
  </Grid>
</Window>
