<Window x:Class="VisualNotes.App.Views.ContextPanelWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Contexto Markdown" Icon="../Assets/VisualNotes.ico" Width="380" Height="225"
 MinWidth="280" MinHeight="180" WindowStyle="ToolWindow" ResizeMode="CanResizeWithGrip"
 Topmost="True" ShowInTaskbar="False"
 AutomationProperties.AutomationId="ContextPanelWindow"
 AutomationProperties.Name="Editor desacoplado de contexto Markdown">
 <Border Background="#F8FAFC" BorderBrush="#334155" BorderThickness="1" Padding="10">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,7">
    <ComboBox DockPanel.Dock="Right" Width="115" ItemsSource="{Binding ContextPlacements}" SelectedItem="{Binding ContextPlacement}"
              AutomationProperties.AutomationId="DetachedContextPlacementSelector" AutomationProperties.Name="Posición del editor de contexto"/>
    <TextBlock Text="Contexto / apunte Markdown" FontWeight="SemiBold" VerticalAlignment="Center"/>
   </DockPanel>
   <TextBox Grid.Row="1" AutomationProperties.AutomationId="DetachedContextMarkdownInput"
            AutomationProperties.Name="Contexto Markdown de la próxima captura"
            Text="{Binding ContextMarkdown, UpdateSourceTrigger=PropertyChanged}"
            AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
   <WrapPanel Grid.Row="2" Margin="0,7,0,0">
    <Button Content="Guardar apunte sin captura" Command="{Binding AddTextNoteCommand}"/>
    <Button Content="Volver al panel" Command="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DockInsideCommand}" Margin="7,0,0,0"/>
   </WrapPanel>
  </Grid>
 </Border>
</Window>
