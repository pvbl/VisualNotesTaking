<Window x:Class="VisualNotes.App.Views.CapturePanelWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Centro de captura de VisualNotes" Icon="../Assets/VisualNotes.ico"
 Width="430" Height="720" MinWidth="240" MinHeight="76"
 WindowStyle="ToolWindow" ResizeMode="CanResizeWithGrip" Topmost="True"
 ShowInTaskbar="False" Opacity="{Binding PanelOpacity}"
 AutomationProperties.AutomationId="CapturePanelWindow"
 AutomationProperties.Name="Centro de captura"
 AutomationProperties.HelpText="Cambia de sesión, prepara el siguiente elemento y revisa el trabajo capturado"
 KeyboardNavigation.TabNavigation="Cycle"
 FocusManager.FocusedElement="{Binding ElementName=CaptureNowButton, Mode=OneWay}">
 <Window.InputBindings>
  <KeyBinding Key="C" Modifiers="Control" Command="{Binding CaptureCommand}"/>
  <KeyBinding Key="Space" Command="{Binding TogglePauseCommand}"/>
  <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
  <KeyBinding Key="M" Modifiers="Control" Command="{Binding ToggleMinimalCommand}"/>
 </Window.InputBindings>
 <Window.Resources>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="10"/>
   <Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,10"/>
  </Style>
  <Style x:Key="Label" TargetType="TextBlock">
   <Setter Property="Foreground" Value="#475569"/><Setter Property="FontSize" Value="11"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,4"/>
  </Style>
  <Style x:Key="DockChoice" TargetType="RadioButton">
   <Setter Property="Width" Value="48"/><Setter Property="Height" Value="38"/>
   <Setter Property="Margin" Value="3"/><Setter Property="Background" Value="#E2E8F0"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="RadioButton">
     <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7"
             BorderBrush="#CBD5E1" BorderThickness="1">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True">
       <Setter TargetName="Surface" Property="Background" Value="#DBEAFE"/>
       <Setter TargetName="Surface" Property="BorderBrush" Value="#2563EB"/>
       <Setter Property="Foreground" Value="#1D4ED8"/>
      </Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
 </Window.Resources>
 <Border Background="#F1F5F9" BorderBrush="#334155" BorderThickness="1">
  <DockPanel Margin="12">
   <DockPanel DockPanel.Dock="Top" Margin="2,0,2,10">
    <Button DockPanel.Dock="Right" Content="—" Command="{Binding ToggleMinimalCommand}"
            Width="34" Height="28" ToolTip="Alternar modo mínimo"
            AutomationProperties.AutomationId="ToggleMinimalButton"
            AutomationProperties.Name="Alternar modo mínimo"/>
    <StackPanel>
     <TextBlock Text="Centro de captura" FontSize="18" FontWeight="Bold" Foreground="#172033"/>
     <TextBlock Text="{Binding SessionStatus}" Foreground="#64748B"
                AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
   </DockPanel>

   <ScrollViewer Visibility="{Binding ExpandedVisibility}" VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="UBICACIÓN DE TRABAJO" Style="{StaticResource Label}"/>
       <TextBlock Text="Curso" Style="{StaticResource Label}"/>
       <ComboBox ItemsSource="{Binding Courses}" SelectedItem="{Binding SelectedCourseName}"
                 AutomationProperties.AutomationId="PanelCourseSelector"/>
       <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,5,0">
         <TextBlock Text="Módulo" Style="{StaticResource Label}"/>
         <ComboBox ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModuleName}"
                   AutomationProperties.AutomationId="PanelModuleSelector"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="5,0,0,0">
         <TextBlock Text="Sesión" Style="{StaticResource Label}"/>
         <ComboBox ItemsSource="{Binding AvailableSessions}" SelectedItem="{Binding SelectedSession}"
                   DisplayMemberPath="Name" AutomationProperties.AutomationId="PanelSessionSelector"/>
        </StackPanel>
       </Grid>
       <TextBlock Text="{Binding SectionName, StringFormat=Sección activa: {0}}"
                  Foreground="#2563EB" FontWeight="SemiBold" Margin="0,8,0,0"/>
      </StackPanel>
     </Border>

     <Border Style="{StaticResource Card}">
      <StackPanel>
       <TextBlock Text="PRÓXIMO ELEMENTO" Style="{StaticResource Label}"/>
       <TextBlock Text="Título" Style="{StaticResource Label}"/>
       <TextBox Text="{Binding CaptureTitle, UpdateSourceTrigger=PropertyChanged}"
                AutomationProperties.AutomationId="CaptureTitleInput"/>
       <TextBlock Text="Etiquetas" Style="{StaticResource Label}" Margin="0,8,0,4"/>
       <TextBox Text="{Binding CaptureTags, UpdateSourceTrigger=PropertyChanged}"
                ToolTip="Separa las etiquetas con comas"
                AutomationProperties.AutomationId="CaptureTagsInput"/>
       <TextBlock Text="Contexto Markdown" Style="{StaticResource Label}" Margin="0,8,0,4"/>
       <TextBox Text="{Binding ContextMarkdown, UpdateSourceTrigger=PropertyChanged}"
                AcceptsReturn="True" TextWrapping="Wrap" MinHeight="82"
                VerticalScrollBarVisibility="Auto"
                AutomationProperties.AutomationId="CaptureContextMarkdownInput"
                AutomationProperties.Name="Contexto Markdown del próximo elemento"/>
       <Grid Margin="0,10,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="CaptureNowButton" Content="● Capturar" Command="{Binding CaptureCommand}"
                Background="#2563EB" Foreground="White" Padding="14,8"
                AutomationProperties.AutomationId="CaptureNowButton"/>
        <Button Grid.Column="1" Content="+ Guardar apunte" Command="{Binding AddTextNoteCommand}"
                Margin="8,0,0,0" Padding="12,8"
                AutomationProperties.AutomationId="AddTextNoteButton"/>
       </Grid>
      </StackPanel>
     </Border>

     <Border Style="{StaticResource Card}">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="176"/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="POSICIÓN" Style="{StaticResource Label}"/>
        <TextBlock Text="Elige dónde se acopla el panel" Foreground="#64748B"
                   TextWrapping="Wrap" Margin="0,0,8,0"/>
       </StackPanel>
       <Grid Grid.Column="1" HorizontalAlignment="Right">
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <RadioButton Grid.Row="0" Grid.Column="1" GroupName="Dock" Content="↑"
                     IsChecked="{Binding IsTopPlacement, Mode=OneWay}" Command="{Binding SelectPlacementCommand}"
                     CommandParameter="Arriba" Style="{StaticResource DockChoice}" ToolTip="Arriba"/>
        <RadioButton Grid.Row="1" Grid.Column="0" GroupName="Dock" Content="←"
                     IsChecked="{Binding IsLeftPlacement, Mode=OneWay}" Command="{Binding SelectPlacementCommand}"
                     CommandParameter="Izquierda" Style="{StaticResource DockChoice}" ToolTip="Izquierda"/>
        <RadioButton Grid.Row="1" Grid.Column="1" GroupName="Dock" Content="◇"
                     IsChecked="{Binding IsFloatingPlacement, Mode=OneWay}" Command="{Binding SelectPlacementCommand}"
                     CommandParameter="Flotante" Style="{StaticResource DockChoice}" ToolTip="Flotante"/>
        <RadioButton Grid.Row="1" Grid.Column="2" GroupName="Dock" Content="→"
                     IsChecked="{Binding IsRightPlacement, Mode=OneWay}" Command="{Binding SelectPlacementCommand}"
                     CommandParameter="Derecha" Style="{StaticResource DockChoice}" ToolTip="Derecha"/>
        <RadioButton Grid.Row="2" Grid.Column="1" GroupName="Dock" Content="↓"
                     IsChecked="{Binding IsBottomPlacement, Mode=OneWay}" Command="{Binding SelectPlacementCommand}"
                     CommandParameter="Abajo" Style="{StaticResource DockChoice}" ToolTip="Abajo"/>
       </Grid>
      </Grid>
     </Border>

     <Button Content="{Binding CaptureCount, StringFormat=Revisar sesión ({0}) →}"
             Command="{Binding OpenReviewCommand}" Background="#0F766E" Foreground="White"
             FontWeight="SemiBold" Padding="16,10" Margin="0,0,0,10"
             AutomationProperties.AutomationId="OpenSessionReviewButton"
             AutomationProperties.Name="Abrir revisión completa de la sesión"/>

     <Expander Header="Más controles" Background="White" Padding="10">
      <StackPanel Margin="0,8,0,0">
       <WrapPanel>
        <ComboBox Width="105" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}"
                  AutomationProperties.AutomationId="CaptureModeSelector"/>
        <Button Content="Pausar / reanudar" Command="{Binding TogglePauseCommand}" Margin="6,0"/>
        <Button Content="{Binding RegionLockLabel}" Command="{Binding ToggleRegionLockCommand}"/>
       </WrapPanel>
       <WrapPanel Margin="0,8,0,0">
        <Button Content="◀ Sección" Command="{Binding PreviousSectionCommand}"/>
        <Button Content="Sección ▶" Command="{Binding NextSectionCommand}" Margin="5,0"/>
        <Button Content="Deshacer" Command="{Binding UndoCommand}"
                AutomationProperties.AutomationId="UndoButton" AutomationProperties.Name="Deshacer última acción"/>
        <Button Content="Importante" Command="{Binding MarkImportantCommand}" Margin="5,0"
                AutomationProperties.AutomationId="MarkImportantButton" AutomationProperties.Name="Marcar última captura como importante"/>
        <Button Content="Contexto último" Command="{Binding AddContextCommand}"
                AutomationProperties.AutomationId="AddContextButton" AutomationProperties.Name="Editar contexto de la última captura"/>
       </WrapPanel>
       <DockPanel Margin="0,8,0,0">
        <Button DockPanel.Dock="Right" Content="+ Crear" Command="{Binding AddSectionCommand}"
                AutomationProperties.AutomationId="PanelAddSectionButton"/>
        <TextBox Text="{Binding NewSectionName, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Nueva sección"/>
       </DockPanel>
       <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <TextBlock Text="Opacidad" VerticalAlignment="Center"/>
        <Slider Width="100" Minimum="0.55" Maximum="1" Value="{Binding PanelOpacity}" Margin="8,0"/>
        <TextBlock VerticalAlignment="Center">
         <Run Text="Cola "/><Run Text="{Binding QueuedCaptures}"/>
        </TextBlock>
       </StackPanel>
      </StackPanel>
     </Expander>
    </StackPanel>
   </ScrollViewer>
  </DockPanel>
 </Border>
</Window>
