<UserControl x:Class="VisualNotes.App.Views.SettingsView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibility"/></UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
  <TextBlock Text="Configuración" FontSize="32" FontWeight="SemiBold" Foreground="#172033"/>
  <TextBlock Text="Configura primero tu API key y después personaliza VisualNotes." FontSize="16" Foreground="#64748B" Margin="0,8,0,30"/>
  <Border Background="White" CornerRadius="10" Padding="28" Margin="0,0,0,18"
          AutomationProperties.AutomationId="ApiCredentialsSection">
   <StackPanel>
    <TextBlock Text="API key de OpenAI" FontSize="20" FontWeight="SemiBold" Foreground="#334155"/>
    <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding SaveCredentialCommand.IsRunning, Converter={StaticResource BoolToVisibility}}"/>
    <TextBlock Text="Pega la clave en el campo «Nueva API key» y pulsa Guardar. Si utilizas una única clave, puedes guardarla tanto para extracción como para composición."
               Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,14"/>
    <TextBlock Text="La clave queda protegida por Windows para tu usuario y el valor guardado nunca vuelve a mostrarse."
               Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <ItemsControl ItemsSource="{Binding CredentialProfiles}"><ItemsControl.ItemTemplate><DataTemplate>
     <Border BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,5">
      <StackPanel>
       <DockPanel>
        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15"/>
        <TextBlock DockPanel.Dock="Right" Text="{Binding MaskedValue, TargetNullValue=No configurada}" Foreground="#64748B"/>
       </DockPanel>
       <PasswordBox PasswordChanged="CredentialPasswordChanged" Margin="0,8,0,8"
                    AutomationProperties.Name="Nueva API key"/>
       <WrapPanel>
        <Button Content="Guardar" Command="{Binding DataContext.SaveCredentialCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Margin="0,0,6,0" Padding="12,5"/>
        <Button Content="Verificar" Command="{Binding DataContext.VerifyCredentialCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Margin="0,0,6,0" Padding="12,5"/>
        <Button Content="Eliminar" Command="{Binding DataContext.DeleteCredentialCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Margin="0,0,12,0" Padding="12,5"/>
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="#334155"/>
       </WrapPanel>
      </StackPanel>
     </Border>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel>
  </Border>
  <Border Background="White" CornerRadius="10" Padding="28" Margin="0,0,0,18">
   <StackPanel>
    <TextBlock Text="Configuración por niveles" FontSize="20" FontWeight="SemiBold" Foreground="#334155"/>
    <TextBlock Text="La captura prevalece sobre sección, sesión, global y valores predeterminados." Foreground="#64748B" Margin="0,4,0,14"/>
    <CheckBox IsChecked="{Binding ImageUploadConsent}" Content="Consiento enviar capturas al proveedor configurado" Margin="0,0,0,14"
              ToolTip="Sin este consentimiento explícito, ningún trabajo puede transmitir una imagen."/>
    <DockPanel Margin="0,0,0,12">
     <TextBlock Text="Editar nivel:" VerticalAlignment="Center" Margin="0,0,10,0"/>
     <ComboBox AutomationProperties.AutomationId="SettingsLevelSelector" ItemsSource="{Binding Levels}"
               SelectedItem="{Binding SelectedLevel}" Width="210" HorizontalAlignment="Left"/>
    </DockPanel>
    <ItemsControl ItemsSource="{Binding EffectiveValues}">
     <ItemsControl.ItemTemplate><DataTemplate>
      <Grid Margin="0,5"><Grid.ColumnDefinitions>
       <ColumnDefinition Width="150"/><ColumnDefinition Width="210"/><ColumnDefinition Width="180"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/>
      </Grid.ColumnDefinitions>
       <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
       <TextBox Grid.Column="1" Text="{Binding EditValue, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0"/>
       <StackPanel Grid.Column="2"><TextBlock Text="{Binding EffectiveValue}" FontWeight="SemiBold"/><TextBlock Text="{Binding Provenance}" Foreground="#64748B" FontSize="11"/></StackPanel>
       <Button Grid.Column="3" Content="Sobrescribir" Command="{Binding DataContext.OverrideSettingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Margin="4,0"/>
       <Button Grid.Column="4" Content="Restaurar" ToolTip="Restaura la herencia del nivel inferior" Command="{Binding DataContext.RestoreSettingCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Margin="4,0"/>
      </Grid>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
   </StackPanel>
  </Border>
  <Border Background="White" CornerRadius="10" Padding="28">
   <StackPanel>
    <TextBlock Text="Atajos globales" FontSize="20" FontWeight="SemiBold" Foreground="#334155"/>
    <TextBlock Text="Los atajos funcionan aunque VisualNotes esté minimizado." Foreground="#64748B" Margin="0,4,0,14"/>
    <ItemsControl ItemsSource="{Binding Bindings}">
     <ItemsControl.ItemTemplate>
      <DataTemplate>
       <DockPanel Margin="0,4">
        <TextBlock Text="{Binding Action}" Width="220" VerticalAlignment="Center"/>
        <CheckBox IsChecked="{Binding IsEnabled}" Content="Activo" Width="70" VerticalAlignment="Center"/>
        <TextBox Text="{Binding Modifiers, UpdateSourceTrigger=PropertyChanged}" Width="130" Margin="0,0,8,0"
                 ToolTip="Modificadores: Control, Shift, Alt o Windows"/>
        <TextBox Text="{Binding VirtualKey, UpdateSourceTrigger=PropertyChanged}" Width="70"
                 ToolTip="Código de tecla virtual de Windows"/>
       </DockPanel>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock AutomationProperties.AutomationId="HotkeyConflictMessage" Text="{Binding ConflictMessage}"
               Foreground="#B91C1C" TextWrapping="Wrap" Margin="0,12,0,0"/>
    <Button AutomationProperties.AutomationId="SaveHotkeysButton" Content="Guardar atajos"
            Command="{Binding SaveCommand}" Width="150" HorizontalAlignment="Left" Margin="0,14,0,0"/>
   </StackPanel>
  </Border>
 </StackPanel></ScrollViewer>
</UserControl>
