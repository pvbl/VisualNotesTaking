<UserControl x:Class="VisualNotes.App.Views.DocumentView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibility"/></UserControl.Resources>
 <DockPanel>
  <StackPanel DockPanel.Dock="Top">
  <TextBlock Text="Documento" FontSize="32" FontWeight="SemiBold" Foreground="#172033"/>
  <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding ExportCommand.IsRunning, Converter={StaticResource BoolToVisibility}}"/>
  <TextBlock Text="Previsualiza el modelo semántico, revisa avisos y decide qué exportar." FontSize="16" Foreground="#64748B" Margin="0,8,0,18"/>
  <Border Background="#FFF7ED" CornerRadius="6" Padding="10" Margin="0,0,0,12" Visibility="{Binding HasWarnings, Converter={StaticResource BooleanToVisibilityConverter}}">
   <TextBlock Text="Hay contenido sin revisar o archivos ausentes." Foreground="#9A3412"/>
  </Border>
  <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
   <ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope}" Width="150"/>
   <Button Content="Incluir" Command="{Binding IncludeCommand}" Margin="8,0,0,0"/>
   <Button Content="Excluir" Command="{Binding ExcludeCommand}" Margin="8,0,0,0"/>
   <Button Content="Subir" Command="{Binding MoveUpCommand}" Margin="8,0,0,0"/>
   <Button Content="Bajar" Command="{Binding MoveDownCommand}" Margin="8,0,0,0"/>
   <Button AutomationProperties.AutomationId="ExportButton" Content="Exportar" Command="{Binding ExportCommand}" Margin="20,0,0,0" Padding="16,5"/>
  </StackPanel>
  </StackPanel>
  <ListView AutomationProperties.AutomationId="DocumentReviewList" AutomationProperties.Name="Contenido del documento para revisión" AutomationProperties.HelpText="Selecciona elementos para incluirlos, excluirlos o reordenarlos" ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" Background="White">
   <ListView.View><GridView>
    <GridViewColumn Header="Incluir" DisplayMemberBinding="{Binding IsIncluded}" Width="65"/>
    <GridViewColumn Header="Tipo" DisplayMemberBinding="{Binding Node.Type}" Width="100"/>
    <GridViewColumn Header="Contenido" Width="390">
     <GridViewColumn.CellTemplate><DataTemplate>
      <TextBox AutomationProperties.Name="Contenido editable del documento"
               Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
               AcceptsReturn="True" TextWrapping="Wrap" MinWidth="350" Padding="5"/>
     </DataTemplate></GridViewColumn.CellTemplate>
    </GridViewColumn>
    <GridViewColumn Header="Estado" DisplayMemberBinding="{Binding State}" Width="110"/>
   </GridView></ListView.View>
  </ListView>
 </DockPanel>
</UserControl>
