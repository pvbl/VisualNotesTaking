<UserControl x:Class="VisualNotes.App.Views.CapturesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibility"/></UserControl.Resources>
 <UserControl.InputBindings><KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/><KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/></UserControl.InputBindings>
 <Grid KeyboardNavigation.TabNavigation="Cycle"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Capturas" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Revisa, organiza y procesa muchas capturas a la vez." Foreground="#64748B" Margin="0,8,0,14"/><ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding ReanalyzeCommand.IsRunning, Converter={StaticResource BoolToVisibility}}"/></StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,14">
   <ComboBox Width="145" ItemsSource="{Binding Sections}" DisplayMemberPath="Title" SelectedValuePath="Id" SelectedValue="{Binding SectionFilter}" IsEditable="True" AutomationProperties.Name="Filtrar por sección"/>
   <TextBox Width="145" Margin="8,0,0,0" Text="{Binding TagFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="CaptureTagFilter" AutomationProperties.Name="Filtrar por etiqueta" ToolTip="Etiqueta"/>
   <ComboBox Width="145" Margin="8,0" ItemsSource="{Binding Statuses}" SelectedItem="{Binding StatusFilter}" IsEditable="True" AutomationProperties.Name="Filtrar por estado"/>
   <ComboBox Width="145" ItemsSource="{Binding Importances}" SelectedItem="{Binding ImportanceFilter}" IsEditable="True" AutomationProperties.Name="Filtrar por importancia"/>
   <ComboBox Width="130" Margin="8,0" ItemsSource="{Binding ReviewOptions}" SelectedItem="{Binding ReviewFilter}" AutomationProperties.Name="Filtrar por revisión"/>
   <Button Content="Limpiar filtros" Command="{Binding ClearFiltersCommand}"/>
  </WrapPanel>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition MinWidth="430" Width="3*"/><ColumnDefinition MinWidth="290" Width="2*"/></Grid.ColumnDefinitions>
   <DockPanel>
    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8"><TextBlock Text="{Binding SelectionCount, StringFormat={}{0} seleccionadas}" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="Excluir" Command="{Binding ExcludeCommand}"/><Button Content="Eliminar" Command="{Binding DeleteCommand}" Margin="6,0"/><Button Content="Restaurar" Command="{Binding RestoreCommand}"/><Button Content="Reprocesar" Command="{Binding ReanalyzeCommand}" Margin="6,0"/><Button Content="Deshacer" Command="{Binding UndoCommand}"/><ComboBox Width="140" Margin="8,0,0,0" ItemsSource="{Binding Sections}" DisplayMemberPath="Title" SelectedValuePath="Id" SelectedValue="{Binding TargetSectionId}" ToolTip="Sección destino"/><Button Content="Mover" Command="{Binding MoveToSectionCommand}" CommandParameter="{Binding TargetSectionId}"/></WrapPanel>
    <ListBox x:Name="CaptureList" AutomationProperties.AutomationId="CaptureList" ItemsSource="{Binding Captures}" SelectionMode="Extended" SelectionChanged="SelectionChanged" AllowDrop="True" Drop="CaptureDrop" PreviewMouseMove="CaptureMouseMove" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.IsDeferredScrollingEnabled="True" AutomationProperties.Name="Lista de capturas">
     <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
     <ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="112"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Image Source="{Binding Image.RelativePath, IsAsync=True}" Width="104" Height="68" Stretch="UniformToFill" AutomationProperties.Name="Miniatura cargada bajo demanda"/>
      <StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="{Binding Section.Title, TargetNullValue=Sin sección}" FontWeight="SemiBold"/><TextBlock Text="{Binding CapturedAt, StringFormat={}{0:HH:mm:ss}}"/><TextBlock Text="{Binding ProcessingStatus, StringFormat=Estado: {0}}"/><TextBlock Text="{Binding UserContext, StringFormat=Contexto: {0}}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Tags, StringFormat=Etiquetas: {0}}" Foreground="#475569"/><TextBlock Text="⚠ Requiere atención" Foreground="#B45309"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ProcessingStatus}" Value="Failed"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding ProcessingStatus}" Value="NeedsReview"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
     </Grid></Border></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
   <ScrollViewer Grid.Column="1" Margin="18,0,0,0" VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="Detalle" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Contexto personal" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBox AutomationProperties.AutomationId="CaptureContextInput" AutomationProperties.Name="Contexto personal de la captura" AutomationProperties.HelpText="Información adicional para interpretar la captura" Text="{Binding SelectedCapture.UserContext, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="72"/>
    <TextBlock Text="Instrucción de procesamiento" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBox Text="{Binding SelectedCapture.CaptureInstruction, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="72"/>
    <TextBlock Text="Etiquetas rápidas" FontWeight="SemiBold" Margin="0,12,0,6"/><ItemsControl ItemsSource="{Binding QuickChips}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" Command="{Binding DataContext.ApplyChipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,7,7" Padding="9,5"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="Etiquetas" FontWeight="SemiBold"/><TextBox Text="{Binding SelectedCapture.Tags, UpdateSourceTrigger=PropertyChanged}"/>
    <WrapPanel Margin="0,12"><Button AutomationProperties.AutomationId="ReanalyzeButton" Content="Volver a analizar" Command="{Binding ReanalyzeCommand}"/><Button AutomationProperties.AutomationId="RegenerateNoteButton" Content="Regenerar nota" Command="{Binding RegenerateNoteCommand}" Margin="8,0"/></WrapPanel>
   </StackPanel></ScrollViewer>
  </Grid>
 </Grid>
</UserControl>
