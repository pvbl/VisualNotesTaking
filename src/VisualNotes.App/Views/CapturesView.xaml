<UserControl x:Class="VisualNotes.App.Views.CapturesView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:services="clr-namespace:VisualNotes.App.Services">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
  <services:MarkdownFlowDocumentConverter x:Key="MarkdownRenderer"/>
  <Style x:Key="ToolbarButton" TargetType="Button">
   <Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,0,6,0"/>
  </Style>
 </UserControl.Resources>
 <UserControl.InputBindings>
  <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
  <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveSelectedCommand}"/>
  <KeyBinding Key="Delete" Command="{Binding DeleteCommand}"/>
 </UserControl.InputBindings>
 <Grid KeyboardNavigation.TabNavigation="Cycle">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,14">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
    <TextBlock Text="{Binding BatchStatus}" Foreground="#0F766E" VerticalAlignment="Center" Margin="0,0,10,0"
               AutomationProperties.LiveSetting="Polite"/>
    <Button Content="{Binding IncludedCount, StringFormat=Procesar sesión ({0})}"
            Command="{Binding RunSessionBatchCommand}" Background="#0F766E" Foreground="White"
            FontWeight="SemiBold" Padding="16,8"
            AutomationProperties.AutomationId="RunSessionBatchButton"/>
   </StackPanel>
   <StackPanel>
    <TextBlock Text="Revisión final" FontSize="32" FontWeight="SemiBold"/>
    <TextBlock Text="Comprueba entradas y Markdown antes de evaluar toda la sesión."
               Foreground="#64748B" Margin="0,5,0,0"/>
   </StackPanel>
  </DockPanel>

  <TabControl Grid.Row="1" SelectedIndex="{Binding ActiveTabIndex}"
              AutomationProperties.AutomationId="ReviewWorkspaceTabs">
   <TabItem Header="Entradas">
    <Grid Margin="10">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <WrapPanel Margin="0,0,0,10">
      <ComboBox Width="135" ItemsSource="{Binding Sections}" DisplayMemberPath="Title"
                SelectedValuePath="Id" SelectedValue="{Binding SectionFilter}" IsEditable="True"
                ToolTip="Filtrar por sección"/>
      <TextBox Width="130" Margin="7,0,0,0" Text="{Binding TagFilter, UpdateSourceTrigger=PropertyChanged}"
               ToolTip="Filtrar por etiqueta"/>
      <ComboBox Width="125" Margin="7,0" ItemsSource="{Binding Statuses}"
                SelectedItem="{Binding StatusFilter}" IsEditable="True" ToolTip="Estado"/>
      <CheckBox Content="Papelera" IsChecked="{Binding ShowTrash}" VerticalAlignment="Center" Margin="8,0"
                AutomationProperties.AutomationId="ShowTrashToggle"/>
      <Button Content="Limpiar filtros" Command="{Binding ClearFiltersCommand}" Style="{StaticResource ToolbarButton}"/>
     </WrapPanel>
     <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition MinWidth="400" Width="3*"/><ColumnDefinition MinWidth="300" Width="2*"/></Grid.ColumnDefinitions>
      <DockPanel>
       <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
        <TextBlock Text="{Binding SelectionCount, StringFormat={}{0} seleccionadas}"
                   VerticalAlignment="Center" Margin="0,0,10,0"/>
        <Button Content="Excluir" Command="{Binding ExcludeCommand}" Style="{StaticResource ToolbarButton}"/>
        <Button Content="Papelera" Command="{Binding DeleteCommand}" Style="{StaticResource ToolbarButton}"/>
        <Button Content="Restaurar" Command="{Binding RestoreCommand}" Style="{StaticResource ToolbarButton}"/>
        <Button Content="Deshacer" Command="{Binding UndoCommand}" Style="{StaticResource ToolbarButton}"/>
        <ComboBox Width="130" ItemsSource="{Binding Sections}" DisplayMemberPath="Title"
                  SelectedValuePath="Id" SelectedValue="{Binding TargetSectionId}" ToolTip="Sección destino"/>
        <Button Content="Mover" Command="{Binding MoveToSectionCommand}"
                CommandParameter="{Binding TargetSectionId}" Margin="6,0,0,0"/>
       </WrapPanel>
       <ListBox x:Name="CaptureList" ItemsSource="{Binding Captures}" SelectionMode="Extended"
                SelectionChanged="SelectionChanged" AllowDrop="True" Drop="CaptureDrop"
                PreviewMouseMove="CaptureMouseMove" VirtualizingPanel.IsVirtualizing="True"
                VirtualizingPanel.VirtualizationMode="Recycling"
                AutomationProperties.AutomationId="CaptureList"
                AutomationProperties.Name="Cronología de capturas y apuntes">
        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
         <DataTemplate>
          <Border BorderBrush="#CBD5E1" BorderThickness="0,0,0,1" Padding="8">
           <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="108"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border Background="#E2E8F0" CornerRadius="6" Width="100" Height="68">
             <Grid>
              <Image Source="{Binding Image.RelativePath, IsAsync=True}" Stretch="UniformToFill"/>
              <TextBlock Text="APUNTE" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Foreground="#475569" FontWeight="Bold">
               <TextBlock.Style><Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding Image}" Value="{x:Null}">
                 <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger></Style.Triggers>
               </Style></TextBlock.Style>
              </TextBlock>
             </Grid>
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0">
             <TextBlock Text="{Binding DisplayTitle, TargetNullValue=Sin título}"
                        FontWeight="SemiBold" FontSize="15"/>
             <TextBlock Foreground="#64748B">
              <Run Text="{Binding Section.AcademicPath, TargetNullValue=Sin sección}"/><Run Text=" · "/>
              <Run Text="{Binding CapturedAt, StringFormat={}{0:HH:mm:ss}}"/>
             </TextBlock>
             <TextBlock Text="{Binding UserContext}" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
             <TextBlock Text="{Binding Tags, StringFormat=Etiquetas: {0}}" Foreground="#475569"/>
            </StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
             <TextBlock Text="{Binding ProcessingStatus}" Foreground="#64748B"/>
             <CheckBox Content="Incluir" IsChecked="{Binding IncludeInDocument}"
                       Click="SaveMetadata" HorizontalAlignment="Right"/>
            </StackPanel>
           </Grid>
          </Border>
         </DataTemplate>
        </ListBox.ItemTemplate>
       </ListBox>
      </DockPanel>

      <ScrollViewer Grid.Column="1" Margin="18,0,0,0" VerticalScrollBarVisibility="Auto">
       <StackPanel>
        <TextBlock Text="Detalle del elemento" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding SaveStatus}" Foreground="#0F766E" Margin="0,2,0,8"
                   AutomationProperties.LiveSetting="Polite"/>
        <TextBlock Text="Título" FontWeight="SemiBold"/>
        <TextBox Text="{Binding SelectedCapture.DisplayTitle, UpdateSourceTrigger=PropertyChanged}"
                 LostKeyboardFocus="SaveMetadata" AutomationProperties.AutomationId="ReviewTitleInput"/>
        <TextBlock Text="Etiquetas" FontWeight="SemiBold" Margin="0,10,0,0"/>
        <TextBox Text="{Binding SelectedCapture.Tags, UpdateSourceTrigger=PropertyChanged}"
                 LostKeyboardFocus="SaveMetadata"/>
        <TextBlock Text="Contexto Markdown" FontWeight="SemiBold" Margin="0,10,0,0"/>
        <TextBox Text="{Binding SelectedCapture.UserContext, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100"
                 LostKeyboardFocus="SaveMetadata"
                 AutomationProperties.AutomationId="CaptureContextInput"
                 AutomationProperties.Name="Contexto Markdown del elemento seleccionado"/>
        <TextBlock Text="Instrucción avanzada" FontWeight="SemiBold" Margin="0,10,0,0"/>
        <TextBox Text="{Binding SelectedCapture.CaptureInstruction, UpdateSourceTrigger=PropertyChanged}"
                 AcceptsReturn="True" MinHeight="65" LostKeyboardFocus="SaveMetadata"/>
        <WrapPanel Margin="0,12">
         <Button Content="Guardar ahora" Command="{Binding SaveSelectedCommand}" Style="{StaticResource ToolbarButton}"/>
         <Button Content="Volver a analizar" Command="{Binding ReanalyzeCommand}" Style="{StaticResource ToolbarButton}"/>
         <Button Content="Regenerar nota" Command="{Binding RegenerateNoteCommand}" Style="{StaticResource ToolbarButton}"/>
        </WrapPanel>
       </StackPanel>
      </ScrollViewer>
     </Grid>
    </Grid>
   </TabItem>

   <TabItem Header="Markdown previo">
    <Grid Margin="10">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <DockPanel Margin="0,0,8,0">
      <TextBlock DockPanel.Dock="Top" Text="Fuente Markdown" FontWeight="SemiBold" Margin="0,0,0,7"/>
      <TextBox Text="{Binding PreviewMarkdown, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True"
               TextWrapping="NoWrap" FontFamily="Consolas"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
     </DockPanel>
     <DockPanel Grid.Column="1" Margin="8,0,0,0">
      <TextBlock DockPanel.Dock="Top" Text="Vista renderizada" FontWeight="SemiBold" Margin="0,0,0,7"/>
      <FlowDocumentScrollViewer Document="{Binding PreviewMarkdown, Converter={StaticResource MarkdownRenderer}}"
                                VerticalScrollBarVisibility="Auto"/>
     </DockPanel>
    </Grid>
   </TabItem>

   <TabItem Header="Resultado">
    <Grid Margin="10">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <DockPanel Margin="0,0,8,0">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,7">
       <TextBlock Text="Markdown editable" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding ResultStatus}" Foreground="#0F766E" Margin="10,0,0,0"
                  AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
      <TextBox Text="{Binding ResultMarkdown, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
               FontFamily="Consolas" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Auto" AutomationProperties.AutomationId="ResultMarkdownEditor"
               LostKeyboardFocus="SaveResultMarkdown"/>
     </DockPanel>
     <DockPanel Grid.Column="1" Margin="8,0,0,0">
      <TextBlock DockPanel.Dock="Top" Text="Vista renderizada" FontWeight="SemiBold" Margin="0,0,0,7"/>
      <FlowDocumentScrollViewer Document="{Binding ResultMarkdown, Converter={StaticResource MarkdownRenderer}}"
                                VerticalScrollBarVisibility="Auto"/>
     </DockPanel>
    </Grid>
   </TabItem>
  </TabControl>
 </Grid>
</UserControl>
