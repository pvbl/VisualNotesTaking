<UserControl x:Class="VisualNotes.App.Views.CapturesView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid KeyboardNavigation.TabNavigation="Cycle"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="Capturas" FontSize="32" FontWeight="SemiBold"/><TextBlock Text="Revisa, contextualiza y decide qué llega al documento." Foreground="#64748B" Margin="0,8,0,20"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <ListBox ItemsSource="{Binding Captures}" SelectedItem="{Binding SelectedCapture}" DisplayMemberPath="CapturedAt" AutomationProperties.Name="Lista de capturas"/>
   <ScrollViewer Grid.Column="1" Margin="18,0,0,0" VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="Contexto personal" FontWeight="SemiBold"/><TextBox Text="{Binding SelectedCapture.UserContext, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="72" AutomationProperties.Name="Contexto personal"/>
    <TextBlock Text="Instrucción de procesamiento" FontWeight="SemiBold" Margin="0,12,0,0"/><TextBox Text="{Binding SelectedCapture.CaptureInstruction, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="72" AutomationProperties.Name="Instrucción de procesamiento"/>
    <TextBlock Text="Etiquetas rápidas" FontWeight="SemiBold" Margin="0,12,0,6"/><ItemsControl ItemsSource="{Binding QuickChips}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding}" Command="{Binding DataContext.ApplyChipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Margin="0,0,7,7" Padding="9,5"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <TextBlock Text="Etiquetas" FontWeight="SemiBold"/><TextBox Text="{Binding SelectedCapture.Tags, UpdateSourceTrigger=PropertyChanged}"/>
    <StackPanel Orientation="Horizontal" Margin="0,10"><TextBlock Text="Importancia" VerticalAlignment="Center"/><ComboBox SelectedValue="{Binding SelectedCapture.Importance}" SelectedValuePath="Tag" Width="140" Margin="8,0,20,0"><ComboBoxItem Content="Normal" Tag="Normal"/><ComboBoxItem Content="Importante" Tag="Important"/><ComboBoxItem Content="Crítica" Tag="Critical"/></ComboBox><CheckBox Content="Incluir en el documento" IsChecked="{Binding SelectedCapture.IncludeInDocument}" VerticalAlignment="Center"/></StackPanel>
    <WrapPanel><Button Content="Volver a analizar" Command="{Binding ReanalyzeCommand}" Padding="12,7" Margin="0,0,8,0"/><Button Content="Regenerar nota" Command="{Binding RegenerateNoteCommand}" Padding="12,7"/></WrapPanel>
    <Border Background="#EFF6FF" Padding="14" Margin="0,16,0,0" Visibility="{Binding IsQuickContextOpen, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="Añade contexto a la captura que acabas de hacer" FontWeight="SemiBold"/><TextBox Text="{Binding SelectedCapture.UserContext, UpdateSourceTrigger=PropertyChanged}" Margin="0,8" AutomationProperties.Name="Contexto rápido de captura"/><Button Content="Listo" Command="{Binding CloseQuickContextCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
   </StackPanel></ScrollViewer>
  </Grid>
 </Grid>
</UserControl>
