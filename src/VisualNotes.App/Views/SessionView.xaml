<UserControl x:Class="VisualNotes.App.Views.SessionView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <UserControl.Resources>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,12,10"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#475569"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto">
  <StackPanel>
   <TextBlock Text="Nueva sesión" FontSize="32" FontWeight="SemiBold" Foreground="#172033"/>
   <TextBlock Text="Prepara el contexto de tus apuntes o recupera el trabajo donde lo dejaste." Foreground="#64748B" Margin="0,6,0,20"/>
   <Border Background="White" CornerRadius="10" Padding="22" Margin="0,0,0,18">
    <StackPanel DataContext="{Binding Draft}">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Título del curso" Style="{StaticResource Label}"/><TextBox AutomationProperties.AutomationId="SessionNameInput" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Módulo" Style="{StaticResource Label}"/><TextBox AutomationProperties.AutomationId="SessionModuleInput" Text="{Binding Module, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Tema" Style="{StaticResource Label}"/><TextBox AutomationProperties.AutomationId="SessionTopicInput" Text="{Binding Topic, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Profesor (opcional)" Style="{StaticResource Label}"/><TextBox Text="{Binding Professor, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="Idioma" Style="{StaticResource Label}"/><TextBox Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Carpeta de trabajo" Style="{StaticResource Label}"/><TextBox Text="{Binding WorkingFolder, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Nombre previsto del documento" Style="{StaticResource Label}"/><TextBox Text="{Binding PlannedDocumentName, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Plantilla de instrucciones" Style="{StaticResource Label}"/><TextBox Text="{Binding InstructionTemplate, UpdateSourceTrigger=PropertyChanged}" Height="58" AcceptsReturn="True"/></StackPanel>
     </Grid>
     <Button AutomationProperties.AutomationId="CreateSessionButton" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Content="Crear desde cero" Command="{Binding CreateCommand}" HorizontalAlignment="Left" Background="#2563EB" Foreground="White"/>
    </StackPanel>
   </Border>

   <TextBlock Text="Sesiones recientes" FontSize="22" FontWeight="SemiBold" Foreground="#172033" Margin="0,0,0,10"/>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions>
    <ListBox AutomationProperties.AutomationId="RecentSessionsList" ItemsSource="{Binding RecentSessions}" SelectedItem="{Binding SelectedSession}" Margin="0,0,16,0" MaxHeight="360">
     <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="8"><TextBlock Text="{Binding Name}" FontWeight="Bold"/><TextBlock Foreground="#64748B"><Run Text="{Binding ModifiedAt, StringFormat={}{0:g}}"/><Run Text=" · "/><Run Text="{Binding Screenshots.Count}"/><Run Text=" capturas"/></TextBlock><TextBlock Foreground="#64748B"><Run Text="Procesamiento: "/><Run Text="{Binding ProcessingStatus}"/><Run Text=" · Última exportación: "/><Run Text="{Binding LastExportedAt, TargetNullValue=—, StringFormat={}{0:g}}"/></TextBlock></StackPanel></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="18">
     <StackPanel>
      <WrapPanel Margin="0,0,0,14"><Button Content="Continuar" Command="{Binding ContinueCommand}"/><Button Content="Duplicar" Command="{Binding DuplicateCommand}"/><Button Content="Guardar cambios" Command="{Binding SaveCommand}"/></WrapPanel>
      <TextBlock Text="Secciones" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Crea secciones jerárquicas y cambia la activa sin detener el vídeo." Foreground="#64748B" Margin="0,3,0,10"/>
      <ListBox AutomationProperties.AutomationId="SectionsList" ItemsSource="{Binding OrderedSections}" SelectedItem="{Binding SelectedSection}" MaxHeight="150"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="5"><TextBlock Text="{Binding Order}" Width="28"/><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description, StringFormat= — {0}}" Foreground="#64748B"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
      <TextBox Text="{Binding SelectedSection.Title, UpdateSourceTrigger=PropertyChanged}" LostKeyboardFocus="AutoSaveSection" ToolTip="Título de la sección"/>
      <TextBox Text="{Binding SelectedSection.Description, UpdateSourceTrigger=PropertyChanged}" LostKeyboardFocus="AutoSaveSection" ToolTip="Descripción"/>
      <WrapPanel><Button AutomationProperties.AutomationId="AddSectionButton" Content="+ Crear subsección" Command="{Binding AddSectionCommand}"/><Button Content="Renombrar" Command="{Binding RenameSectionCommand}"/><Button Content="↑" Command="{Binding MoveUpCommand}"/><Button Content="↓" Command="{Binding MoveDownCommand}"/><Button AutomationProperties.AutomationId="ActivateSectionButton" Content="Cambiar a esta sección" Command="{Binding ActivateSectionCommand}" CommandParameter="{Binding SelectedSection}"/></WrapPanel>
     </StackPanel>
    </Border>
   </Grid>
  </StackPanel>
 </ScrollViewer>
</UserControl>
